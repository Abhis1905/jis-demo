# ==============================================================================
# Judiciary Information System (JIS) — Environment Configuration Template
# Copy this file to .env and configure values for your local environment:
#   cp .env.example .env
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=https://jis-demo.vercel.app

# MySQL Database Configuration (Individual Parameters)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=jis_dev_db

# Cloud / Hosted MySQL SSL/TLS Options (Required for Remote Providers like Aiven, TiDB, AWS RDS)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Connection Pool Options
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# Alternative: Unified Connection String (Supported on cloud providers)
# DATABASE_URL=mysql://username:password@remote-host:3306/database_name?ssl={"rejectUnauthorized":true}
