# ==============================================================================
# Judiciary Information System (JIS) — Environment Configuration Template
# Copy this file to .env and configure values for your environment:
#   cp .env.example .env
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=https://jis-demo.vercel.app

# ------------------------------------------------------------------------------
# Option A: Local Development MySQL Configuration (Default)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_local_password
DB_NAME=jis_dev_db
DB_SSL=false
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# ------------------------------------------------------------------------------
# Option B: Aiven Free MySQL (Hosted Test Database — $0/mo Free Tier)
# In Aiven Console, create database 'jis_test_db' and download Project CA:
# ------------------------------------------------------------------------------
# DB_HOST=mysql-xxxx-your-project.aivencloud.com
# DB_PORT=25060
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password
# DB_NAME=jis_test_db
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_CA=./ca.pem  # Or paste raw certificate: -----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DB_CONNECTION_LIMIT=5
# DB_CONNECT_TIMEOUT=15000

# Alternative: Unified Connection URI provided by Aiven
# DATABASE_URL=mysql://avnadmin:password@mysql-xxxx.aivencloud.com:25060/jis_test_db?ssl-mode=REQUIRED
