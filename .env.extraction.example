# JIS Legal Data Extraction Pipeline - Configuration Template
# Copy to .env.extraction or populate in .env when credentials are available.

# 1. IndiaCode eCourts API (Primary, Free, Keyless)
INDIACODE_BASE_URL=https://indiacode.ecourtsindia.com/api/v1/judgments
INDIACODE_RATE_LIMIT_PER_MIN=300
INDIACODE_REQUEST_DELAY_MS=250

# 2. Indian Kanoon API (Requires Authorized Developer Token)
# To obtain access: register at https://api.indiankanoon.org/
# Free trial / academic allowances require explicit approval.
# DO NOT bypass Cloudflare or attempt scraping.
INDIAN_KANOON_API_BASE=https://api.indiankanoon.org
INDIAN_KANOON_API_TOKEN=

# 3. eCourtsIndia API (Commercial API, Requires Paid Credits)
# To obtain access: register at https://ecourtsindia.com/api/docs
# DO NOT purchase credits or activate subscriptions without approval.
ECOURTS_INDIA_API_BASE=https://ecourtsindia.com/api
ECOURTS_INDIA_API_KEY=

# Pipeline Settings
EXTRACTION_OUTPUT_DIR=data/bulk_extraction_50000
TARGET_RECORD_COUNT=50000
PAGE_SIZE=100
MAX_RETRIES=3
CHECKPOINT_INTERVAL=10
